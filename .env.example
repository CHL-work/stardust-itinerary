# Local PostgreSQL used by migration, identity, and fixture commands.
DATABASE_URL=postgresql://stardust:stardust@localhost:5432/stardust
# Direct connection for migrations and backups. Local Compose uses the same endpoint.
DATABASE_DIRECT_URL=postgresql://stardust:stardust@localhost:5432/stardust

# Public URL used for deep links. Do not include a trailing slash.
APP_BASE_URL=http://localhost:3100
# Comma-separated browser origins allowed to submit authenticated mutations.
# Keep the canonical public domain in APP_BASE_URL; these defaults preserve direct local testing.
APP_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Default demo locale: en, zh-HK, zh-HK-lihkg, or ja-JP.
DEFAULT_LOCALE=zh-HK-lihkg

# Identity configuration. Authentication fails closed while required values are blank.
# Register both local callbacks on the same Google web client:
# http://localhost:3100/api/auth/google/callback
# http://localhost:3100/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On-demand MapLibre/OSM map. No paid key required. Community-service limits and
# public-place-only privacy/cache behavior are documented in docs/DAILY_MAP.md.
# Leave empty to use the documented defaults. Set a service to off to disable it.
STARDUST_MAP_TILE_URL=
STARDUST_MAP_GEOCODER=
STARDUST_MAP_GEOCODER_URL=
STARDUST_MAP_ROUTER=
STARDUST_MAP_ROUTER_URL=
STARDUST_MAP_CACHE_DIR=
# Legacy Google adapter only; never selected as the default or OSM fallback.
# Do not activate until Static delivery-policy/browser-key review is complete.
STARDUST_MAPS_ALLOW_METERED=false
STARDUST_GOOGLE_MAPS_API_KEY=
# Optional URL-signing secret from Maps Static API settings (not an OAuth secret).
STARDUST_GOOGLE_MAPS_SIGNING_SECRET=
AUTH_SECRET=
# Admission grace for new assigned claims/reusable joins after trip end; not session lifetime.
# Fresh Google authentication has a fixed 30-day ceiling and a 24-hour rolling activity window.
AUTH_TRIP_GRACE_DAYS=2
# Optional verified-email restriction for bootstrap and server-only platform AI entitlement.
# Ordinary trip ownership still uses the verified issuer/subject, never an email supplied by a client.
OWNER_GOOGLE_EMAIL=
# Self-service Google account onboarding without an existing trip. Keep off until public-launch review.
PUBLIC_SIGNUP_ENABLED=false
# Destination-only subscription Sol lookups for authenticated trip creators.
# creators (default), operator (operator only), or off (manual selection).
# Separate from host-funded trip planning; never enables public signup/API billing.
STARDUST_DESTINATION_LOOKUP=creators
# Optional one-time local owner recovery credential; use 32+ random characters.
OWNER_BOOTSTRAP_SECRET=

# The local Codex SDK adapter uses the machine's official Codex login and no browser-held secret.
# Reserved for later provider adapters. Leave blank locally.
ANTHROPIC_API_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
TELEGRAM_BOT_TOKEN=

# Separate daily feedback reviewer; never grants trip chat repository capabilities.
STARDUST_FEEDBACK_TRIAGE_ENABLED=false
# Dedicated fine-grained token: CHL-work/stardust-itinerary, Issues read/write only.
# Optional; absent credentials keep consented issues queued. Never a NEXT_PUBLIC variable.
STARDUST_FEEDBACK_GITHUB_TOKEN=
# Optional hexadecimal Git commit ID for coarse report diagnostics.
STARDUST_BUILD_VERSION=
