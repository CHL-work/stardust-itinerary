# Stardust Itinerary configuration.
# Docker Compose reads .env; `pnpm dev` reads .env.local. Never commit either file.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------
# Public URL of this instance, without a trailing slash, and the browser origins allowed to send
# authenticated changes (the public URL plus any direct local addresses you use).
APP_BASE_URL=http://localhost:3100
APP_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Session-signing and encryption secret, 32+ random characters: openssl rand -base64 32
AUTH_SECRET=
# Docker Compose only: password for the bundled PostgreSQL (use hex so it is URL-safe):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Google sign-in (needed to sign in). Create an OAuth "Web application" client and register:
#   <APP_BASE_URL>/api/auth/google/callback
#   <APP_BASE_URL>/api/integrations/google-calendar/callback
# ---------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your own Google email: the platform operator, whose AI keys fund trips you own.
OWNER_GOOGLE_EMAIL=
# true lets any Google account that can sign in create an account and trips. On a private
# instance, keep the OAuth client in Google's "Testing" mode so only your test users can sign in.
PUBLIC_SIGNUP_ENABLED=false

# Guest accounts: "Try as guest" on the sign-in page gives anyone a demo trip that is permanently
# deleted after 24 hours, with AI only on the guest's own API key. Off unless set to true.
GUEST_MODE_ENABLED=false
# At most this many guests at once (default 200), and from one address (default 3).
GUEST_ACTIVE_LIMIT=
GUEST_PER_ADDRESS_LIMIT=
# Cloudflare Turnstile keys for the guest button. Required: with guest mode on and no secret, guest
# creation is refused, unless GUEST_ALLOW_WITHOUT_TURNSTILE=true waives the check on a private instance.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUEST_ALLOW_WITHOUT_TURNSTILE=false

# ---------------------------------------------------------------------------------------------
# AI providers: the operator's API keys. Leave a provider blank to disable its models.
# ---------------------------------------------------------------------------------------------
OPENAI_API_KEY=
# The Codex SDK reads this name in non-interactive runs; use the same OpenAI key.
CODEX_API_KEY=
ANTHROPIC_API_KEY=
# Encrypts users' own API keys (Settings → AI keys): 32 random bytes, base64 (openssl rand -base64 32).
# Without it, saving personal keys is disabled. To rotate it, raise the version, keep the old key in
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS as version:key until credential-reencrypt has run, then remove it
# (see docs/DEPLOYMENT.md#rotating-the-encryption-key).
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
# Gemini: a Gemini API key, or a Vertex AI API key together with its project and location.
STARDUST_GEMINI_API_KEY=
STARDUST_GEMINI_VERTEX_PROJECT=
STARDUST_GEMINI_VERTEX_LOCATION=global

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------
# Default interface language: en, zh-HK, zh-HK-lihkg or ja-JP.
DEFAULT_LOCALE=en
# Days after a trip ends during which new invitations can still be claimed.
AUTH_TRIP_GRACE_DAYS=2
# Destination time-zone/currency suggestions on Create Trip: creators, operator or off.
STARDUST_DESTINATION_LOOKUP=creators
# Daily AI triage of in-app feedback, and an optional token that publishes consented reports
# as GitHub issues (fine-grained, Issues read/write on ONE private repository). The publisher
# refuses a repository that GitHub does not report as private.
STARDUST_FEEDBACK_TRIAGE_ENABLED=false
STARDUST_FEEDBACK_REPOSITORY=
STARDUST_FEEDBACK_GITHUB_TOKEN=
# An https link to your privacy notice, shown on the sign-in page (adapt docs/PRIVACY.md).
PRIVACY_NOTICE_URL=
# AI requests the web server runs at once (default 4); each starts provider processes.
STARDUST_AI_MAX_CONCURRENT=

# Day map (MapLibre + OpenStreetMap, no key needed). Leave blank for the documented defaults;
# set a service to "off" to disable it. See docs/DAILY_MAP.md.
STARDUST_MAP_TILE_URL=
STARDUST_MAP_GEOCODER=
STARDUST_MAP_GEOCODER_URL=
STARDUST_MAP_ROUTER=
STARDUST_MAP_ROUTER_URL=
STARDUST_MAP_CACHE_DIR=
STARDUST_MAPS_ALLOW_METERED=false
STARDUST_GOOGLE_MAPS_API_KEY=
STARDUST_GOOGLE_MAPS_SIGNING_SECRET=

# One-time owner recovery credential (32+ random characters); remove it after use.
OWNER_BOOTSTRAP_SECRET=

# ---------------------------------------------------------------------------------------------
# Local development without Docker (pnpm dev): your own PostgreSQL 17.
# ---------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://stardust:stardust@localhost:5432/stardust
DATABASE_DIRECT_URL=postgresql://stardust:stardust@localhost:5432/stardust
