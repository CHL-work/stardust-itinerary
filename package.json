{
  "name": "stardust-itinerary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stardust Itinerary (星塵遠征軍): an AI-first group trip planner with shared itineraries, expenses and disruption checks",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "predev": "node scripts/prepare-map-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "prebuild": "node scripts/prepare-map-assets.mjs",
    "build": "next build",
    "prestart": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "tsx --test --test-reporter=spec tests/database/migrations.test.mjs",
    "test:ai:local": "tsx scripts/test-local-ai.ts",
    "test:ai:reservation": "tsx scripts/test-ai-reservation.ts",
    "test:ai:reservation-clarification": "tsx scripts/test-ai-reservation-clarification.ts",
    "test:ai:search": "tsx scripts/test-ai-search.ts",
    "test:ai:pending-edit": "tsx scripts/test-ai-pending-edit.ts",
    "maintenance:translate-local-itinerary": "tsx scripts/translate-local-itinerary.ts",
    "monitor:disruptions": "node --env-file-if-exists=.env.local --import tsx scripts/run-disruption-monitor.ts",
    "feedback:run": "node --env-file-if-exists=.env.local --import tsx scripts/run-feedback-worker.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/prepare-standalone.mjs && node scripts/smoke.mjs",
    "bootstrap:local-owner": "node scripts/bootstrap-local-owner.mjs",
    "setup:local-auth": "node scripts/setup-local-auth.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:seed:local-trip": "node --env-file-if-exists=.env.local scripts/db/seed-local-trip.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@openai/codex-sdk": "0.165.0",
    "lucide-react": "1.33.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.1",
    "openid-client": "6.8.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tsx": "4.20.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
